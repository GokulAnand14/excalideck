{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Excalideck",
  "version": "0.1.5",
  "identifier": "com.excalideck.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Excalideck",
        "width": 1360,
        "height": 860,
        "minWidth": 880,
        "minHeight": 620,
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2NTVDRjM1RTFGRkIxNUIKUldSYnNmL2hOYzlWdG1TYi94RlZXWDF3SzFOd2lFbnhScW9Kd0NCaFFweitoM0ZjTFpVVStvSzAK",
      "endpoints": [
        "https://github.com/GokulAnand14/excalideck/releases/latest/download/latest.json"
      ]
    }
  }
}
